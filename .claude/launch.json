{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "firesync-api",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--env-file", "backend/.env", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "firesync-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
